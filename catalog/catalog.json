{
  "$comment": "Curated UI catalog. Checked against catalog/arc1.json (generated from ARC-1's source) by `npm run check`. Labels and help texts live in locales/*.json under `cat`.",
  "groups": [
    { "id": "perm", "icon": "shield" },
    { "id": "quality", "icon": "badge" },
    { "id": "conn", "icon": "plug" },
    { "id": "btp", "icon": "cloud" },
    { "id": "feat", "icon": "radar" },
    { "id": "tools", "icon": "wrench" },
    { "id": "perf", "icon": "gauge" },
    { "id": "log", "icon": "list" },
    { "id": "plugins", "icon": "puzzle" }
  ],
  "connection": ["SAP_URL", "SAP_USER", "SAP_PASSWORD", "SAP_CLIENT", "SAP_LANGUAGE"],
  "settings": {
    "SAP_ALLOW_WRITES": { "group": "perm", "type": "bool", "default": "false" },
    "SAP_ALLOWED_PACKAGES": { "group": "perm", "type": "list", "default": "$TMP" },
    "SAP_ALLOW_TRANSPORT_WRITES": { "group": "perm", "type": "bool", "default": "false" },
    "SAP_ALLOWED_TRANSPORTS": { "group": "perm", "type": "list", "default": "" },
    "SAP_ALLOW_GIT_WRITES": { "group": "perm", "type": "bool", "default": "false" },
    "SAP_ALLOW_DATA_PREVIEW": { "group": "perm", "type": "bool", "default": "false" },
    "SAP_ALLOW_FREE_SQL": { "group": "perm", "type": "bool", "default": "false" },
    "SAP_BLOCKED_DATA_SOURCES": { "group": "perm", "type": "list", "default": "", "strict": true },
    "SAP_DENY_ACTIONS": { "group": "perm", "type": "text", "default": "", "strict": true },

    "SAP_LINT_BEFORE_WRITE": { "group": "quality", "type": "bool", "default": "true" },
    "SAP_CHECK_BEFORE_WRITE": { "group": "quality", "type": "bool", "default": "false" },
    "SAP_ABAPLINT_CONFIG": { "group": "quality", "type": "path", "default": "" },

    "SAP_INSECURE": { "group": "conn", "type": "bool", "default": "false" },
    "SAP_SYSTEM_TYPE": { "group": "conn", "type": "enum", "options": ["auto", "onprem", "btp"], "default": "auto" },
    "SAP_ABAP_RELEASE": { "group": "conn", "type": "text", "default": "", "pattern": "^\\d{3}$" },
    "SAP_DISABLE_SAML": { "group": "conn", "type": "bool", "default": "false" },
    "SAP_COOKIE_FILE": { "group": "conn", "type": "path", "default": "" },
    "SAP_COOKIE_STRING": { "group": "conn", "type": "text", "default": "", "secret": true },
    "SAP_USER_AGENT": { "group": "conn", "type": "text", "default": "", "defaultText": "arc-1/<version>", "strict": true, "pattern": "^[\\x20-\\x7E]{1,256}$" },
    "SAP_GZIP_DATAPREVIEW_BODY": { "group": "conn", "type": "bool", "default": "false" },

    "SAP_BTP_SERVICE_KEY_FILE": { "group": "btp", "type": "path", "default": "" },
    "SAP_BTP_SERVICE_KEY": { "group": "btp", "type": "text", "default": "", "secret": true },
    "SAP_BTP_OAUTH_CALLBACK_PORT": { "group": "btp", "type": "int", "default": "0", "min": 0, "max": 65535 },

    "SAP_FEATURE_ABAPGIT": { "group": "feat", "type": "feature", "label": "abapGit" },
    "SAP_FEATURE_GCTS": { "group": "feat", "type": "feature", "label": "gCTS" },
    "SAP_FEATURE_RAP": { "group": "feat", "type": "feature", "label": "RAP" },
    "SAP_FEATURE_AMDP": { "group": "feat", "type": "feature", "label": "AMDP" },
    "SAP_FEATURE_UI5": { "group": "feat", "type": "feature", "label": "UI5" },
    "SAP_FEATURE_UI5REPO": { "group": "feat", "type": "feature", "label": "UI5 Repository" },
    "SAP_FEATURE_FLP": { "group": "feat", "type": "feature", "label": "Fiori Launchpad" },
    "SAP_FEATURE_TRANSPORT": { "group": "feat", "type": "feature", "label": "Transport (CTS)" },
    "SAP_FEATURE_HANA": { "group": "feat", "type": "feature", "label": "HANA" },

    "ARC1_TOOL_MODE": { "group": "tools", "type": "enum", "options": ["standard", "hyperfocused"], "default": "standard" },
    "ARC1_SERVER_NAME": { "group": "tools", "type": "text", "default": "arc-1" },
    "ARC1_SYSTEM_LABEL": { "group": "tools", "type": "text", "default": "", "maxLength": 160, "strict": true },
    "ARC1_IDE_LINKS": { "group": "tools", "type": "enum", "options": ["off", "eclipse"], "default": "off", "strict": true },
    "ARC1_IDE_SYSTEM_ID": { "group": "tools", "type": "text", "default": "", "pattern": "^[A-Z][A-Z0-9]{2}$", "strict": true },
    "ARC1_SCHEMA_NULLABLE_OPTIONALS": { "group": "tools", "type": "enum", "options": ["auto", "on", "off"], "default": "auto", "strict": true },
    "ARC1_UI": { "group": "tools", "type": "enum", "options": ["off", "local"], "hiddenOptions": ["web", "true", "false"], "default": "off", "strict": true },
    "ARC1_UI_OPEN": { "group": "tools", "type": "bool", "default": "false" },
    "ARC1_UI_ADDR": { "group": "tools", "type": "text", "default": "127.0.0.1:8711" },
    "ARC1_UI_PORT": { "group": "tools", "type": "int", "min": 1, "max": 65535, "strict": true },

    "ARC1_CACHE": { "group": "perf", "type": "enum", "options": ["auto", "memory", "sqlite", "none"], "default": "auto" },
    "ARC1_CACHE_FILE": { "group": "perf", "type": "path", "default": ".arc1-cache.db" },
    "ARC1_MAX_CONCURRENT": { "group": "perf", "type": "int", "default": "10", "min": 1 },
    "ARC1_MAX_DATAPREVIEW_RESPONSE_BYTES": { "group": "perf", "type": "int", "default": "2097152", "min": 1, "strict": true },
    "ARC1_MAX_CONCURRENT_DATA_RESULTS": { "group": "perf", "type": "int", "default": "2", "min": 1, "strict": true },

    "ARC1_LOG_LEVEL": { "group": "log", "type": "enum", "options": ["debug", "info", "warn", "error"], "default": "info" },
    "ARC1_LOG_FORMAT": { "group": "log", "type": "enum", "options": ["text", "json"], "default": "text" },
    "ARC1_LOG_FILE": { "group": "log", "type": "path", "default": "" },
    "ARC1_LOG_HTTP_DEBUG": { "group": "log", "type": "bool", "default": "false", "trueOnly": true },
    "ARC1_MINIMAL_ERRORS": { "group": "log", "type": "bool", "default": "false" },
    "SAP_VERBOSE": { "group": "log", "type": "bool", "default": "false" },

    "ARC1_PLUGINS": { "group": "plugins", "type": "list", "default": "" },
    "SAP_ALLOW_PLUGIN_EXECUTE": { "group": "plugins", "type": "bool", "default": "false" },
    "SAP_ALLOW_PLUGIN_RAW_WRITES": { "group": "plugins", "type": "bool", "default": "false" }
  },
  "serverOnly": [
    "SAP_TRANSPORT",
    "ARC1_PORT",
    "ARC1_HTTP_ADDR",
    "SAP_HTTP_ADDR",
    "ARC1_PUBLIC_URL",
    "ARC1_MAX_HTTP_REQUEST_BYTES",
    "ARC1_ALLOWED_ORIGINS",
    "ARC1_ALLOW_HTTP_NO_AUTH",
    "ARC1_API_KEYS",
    "ARC1_AUTH_RATE_LIMIT",
    "ARC1_MCP_HTTP_RATE_LIMIT",
    "ARC1_RATE_LIMIT",
    "ARC1_DCR_SIGNING_SECRET",
    "ARC1_OAUTH_DCR_ENABLED",
    "ARC1_OAUTH_DCR_REDIRECT_URI_PATTERNS",
    "ARC1_OAUTH_DCR_TTL_SECONDS",
    "ARC1_MULTI_TARGET_ENDPOINTS",
    "ARC1_MULTI_TARGET_AUTHORIZATION",
    "ARC1_MULTI_TARGET_ALLOW_BASIC_AUTH",
    "SAP_BTP_DESTINATION",
    "SAP_BTP_PP_DESTINATION",
    "SAP_OIDC_ISSUER",
    "SAP_OIDC_AUDIENCE",
    "SAP_OIDC_CLOCK_TOLERANCE",
    "SAP_OIDC_DISCOVERY",
    "SAP_OIDC_SCOPES",
    "SAP_XSUAA_AUTH",
    "SAP_PP_ENABLED",
    "SAP_PP_STRICT",
    "SAP_PP_ALLOW_SHARED_COOKIES"
  ],
  "legacyRules": {
    "SAP_READ_ONLY": { "to": "SAP_ALLOW_WRITES", "invert": true },
    "SAP_BLOCK_DATA": { "to": "SAP_ALLOW_DATA_PREVIEW", "invert": true },
    "SAP_BLOCK_FREE_SQL": { "to": "SAP_ALLOW_FREE_SQL", "invert": true },
    "SAP_ENABLE_TRANSPORTS": { "to": "SAP_ALLOW_TRANSPORT_WRITES" },
    "SAP_ENABLE_GIT": { "to": "SAP_ALLOW_GIT_WRITES" },
    "SAP_ALLOWED_OPS": { "note": "legacy.denyactions" },
    "SAP_DISALLOWED_OPS": { "note": "legacy.denyactions" },
    "ARC1_PROFILE": { "note": "legacy.profile" },
    "ARC1_API_KEY": { "note": "legacy.apikey" }
  }
}
